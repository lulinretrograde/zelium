{
  "manifest_version": 3,
  "name": "Zelium",
  "short_name": "Zelium",
  "version": "0.5.0",
  "description": "A Zed-style command palette for Helium and every Chromium browser: search tabs, bookmarks, history, commands and the web from one box.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Zelium",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "welcome.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Alt+K",
        "mac": "Command+K"
      },
      "description": "Open / close the Zelium palette"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "history",
    "bookmarks",
    "sessions",
    "search",
    "storage",
    "favicon"
  ],
  "optional_permissions": [
    "downloads",
    "downloads.open"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "frame.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
